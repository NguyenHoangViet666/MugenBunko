# Docker Compose reads this file when passed with --env-file.
DB_NAME=mugenbunko
DB_APP_USER=mugen_app
DB_ADMIN_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
FRONTEND_URL=https://your-domain.example
PUBLIC_URL=https://your-domain.example
HOST_BIND=127.0.0.1
HOST_PORT=5000
TRUST_PROXY=1
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=100
API_REPLICAS=1
API_RATE_LIMIT=30000
ACCOUNT_RATE_LIMIT=1200
AUTH_IP_RATE_LIMIT=3000
AUTH_ACCOUNT_RATE_LIMIT=15
REDIS_URL=
REDIS_PREFIX=mugenbunko:production
# For docker-compose.scale.yml: use a random 64-character hex string.
REDIS_PASSWORD=
SCHEDULER_ENABLED=true
METRICS_TOKEN=
LOG_LEVEL=warn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
