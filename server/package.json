{
  "name": "mugenbunko-backend",
  "version": "1.0.0",
  "description": "Backend API server for MUGENBUNKO platform using Express and TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "check:smtp": "npm run build && node dist/checkSmtp.js",
    "test:upgrades": "npm run build && node --test dist/tests/upgrades.test.js",
    "migrate:production": "node dist/migrateProduction.js",
    "create:admin": "node dist/createAdmin.js",
    "test:security": "npm run build && node --test dist/tests/security.test.js dist/tests/hardening.test.js dist/tests/otpMigration.test.js dist/tests/otpEmail.test.js dist/tests/passwords.test.js",
    "test:passwords": "npm run build && node --test dist/tests/passwords.test.js",
    "test:elections": "npm run build && node --test dist/tests/elections.test.js",
    "payments:preflight": "npm run build && node dist/payments/preflight.js",
    "test:payments:foundation": "npm run build && node --test dist/tests/paymentFoundation.test.js",
    "test:payments:migration": "npm run build && node --test dist/tests/paymentMigration.test.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.1.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "sanitize-html": "^2.18.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
