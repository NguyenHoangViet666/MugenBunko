PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=mugenbunko
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=100

# Use a persistent, random secret; production refuses short/default secrets.
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5000
# Leave unset locally. In production specify the trusted reverse proxy/hop count.
TRUST_PROXY=
# Set true only to test locally without sending email. Production never exposes OTP.
DEV_OTP=false
# Use SMTP_USER/SMTP_PASS, not the old EMAIL_USER/EMAIL_PASS names.
# Gmail: sender email + App Password (requires 2-Step Verification).
# Port 587 uses STARTTLS (false); port 465 uses implicit TLS (true).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
